{
  "name": "scrumation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.2",
    "npm": "12.2.1"
  },
  "packageManager": "npm@12.2.1",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @scrumation/web --",
    "build": "npm run build --workspace @scrumation/web",
    "preview": "npm run preview --workspace @scrumation/web --",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspace @scrumation/web",
    "typecheck": "npm run typecheck --workspace @scrumation/web && tsc --project tsconfig.tools.json",
    "test": "npm run test --workspace @scrumation/web",
    "test:browser": "playwright test",
    "infra:synth": "cdk synth --app 'uv run --frozen --package scrumation-infra python -m scrumation_infra' --context deploymentEnvironment=dev --context awsAccount=000000000000 --context awsRegion=eu-west-1 --no-lookups --output infra/cdk.out --quiet",
    "check": "bash scripts/check.sh",
    "audit": "npm audit && uv run --frozen pip-audit --local"
  },
  "overrides": {
    "minimatch": "11.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "aws-cdk": "2.1147.0",
    "prettier": "3.9.10"
  }
}
